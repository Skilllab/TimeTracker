# TimeTracker — единые правила стиля кода для всех проектов решения
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{xaml,axaml,xml}]
indent_size = 2

[*.{csproj,props,targets,slnx,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# --- C# ---
[*.{cs,csx}]
# using-директивы
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:suggestion

# NS: file-scoped всегда
csharp_style_namespace_declarations = file_scoped:warning

# Квалификация (this.) — не обязательна
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# Предопределённые типы (string вместо String)
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion

# var
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Скобки и выражения
csharp_prefer_braces = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion
csharp_style_expression_bodied_constructors = false:suggestion

# Современные конструкции
csharp_style_throw_expression = true:suggestion
csharp_style_prefer_null_check_over_is_null = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_readonly_field = true:suggestion

# Модификаторы
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
csharp_style_prefer_readonly_struct = true:suggestion

# --- Именование ---
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = i_prefixed
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.i_prefixed.required_prefix = I
dotnet_naming_style.i_prefixed.capitalization = pascal_case

dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

dotnet_naming_rule.constants_pascal.severity = suggestion
dotnet_naming_rule.constants_pascal.symbols = constants
dotnet_naming_rule.constants_pascal.style = pascal
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.applicable_accessibilities = *
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_style.pascal.capitalization = pascal_case

# Требовать expression body (=>)если код помещается в одну строку
# Конструкторы
dotnet_style_expression_bodied_constructors = true:suggestion
# Методы
dotnet_style_expression_bodied_methods = true:suggestion
# Свойства (Properties)
dotnet_style_expression_bodied_properties = true:suggestion
# Индексаторы
dotnet_style_expression_bodied_indexers = true:suggestion
# Операторы
dotnet_style_expression_bodied_operators = true:suggestion
# Локальные функции
dotnet_style_expression_bodied_local_functions = true:suggestion
# Доступ к свойствам (лямбда для get/set)
dotnet_style_expression_bodied_accessors = true:suggestion

# Отключить предупреждение CS1591 для всех файлов тестовых проектов
[tests/**/*.cs]
dotnet_diagnostic.CS1591.severity = none
# Отключаем для тестовых проектов
# Конструкторы
dotnet_style_expression_bodied_constructors = false:suggestion
# Методы
dotnet_style_expression_bodied_methods = false:suggestion
# Свойства (Properties)
dotnet_style_expression_bodied_properties = false:suggestion
# Индексаторы
dotnet_style_expression_bodied_indexers = false:suggestion
# Операторы
dotnet_style_expression_bodied_operators = false:suggestion
# Локальные функции
dotnet_style_expression_bodied_local_functions = false:suggestion
# Доступ к свойствам (лямбда для get/set)
dotnet_style_expression_bodied_accessors = false:suggestion
