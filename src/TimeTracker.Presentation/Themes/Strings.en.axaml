<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <x:String x:Key="App.Title">TimeTracker</x:String>
  <x:String x:Key="Nav.Timer">Timer</x:String>
  <x:String x:Key="Nav.Entries">Today</x:String>
  <x:String x:Key="Entries.Title">Today</x:String>
  <x:String x:Key="Timer.Start">Start</x:String>
  <x:String x:Key="Timer.Pause">Pause</x:String>
  <x:String x:Key="Timer.Resume">Resume</x:String>
  <x:String x:Key="Timer.Stop">Stop</x:String>

  <x:String x:Key="Nav.Settings">Settings</x:String>
  <x:String x:Key="Settings.Title">Settings</x:String>
  <x:String x:Key="Settings.Idle">Count as idle after</x:String>
  <x:String x:Key="Settings.IdleMinutes">minutes</x:String>
  <x:String x:Key="Settings.HotKey">Hot key</x:String>
  <x:String x:Key="Settings.HotKeyBusy">The combination is used by another program</x:String>
  <x:String x:Key="Tray.Show">Show window</x:String>
  <x:String x:Key="Tray.Exit">Exit</x:String>

  <x:String x:Key="Settings.AutoStart">Start with system</x:String>


</ResourceDictionary>
