<!--Словарь значений. Отвечает на вопрос «как выглядит»-->
<!--словарь стилей — «кто и когда это применяет»-->

<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="BrushBackground" Color="#FAFAFA" />
      <SolidColorBrush x:Key="BrushSurface" Color="#FFFFFF" />
      <SolidColorBrush x:Key="BrushBorder" Color="#E0E0E0" />
      <SolidColorBrush x:Key="BrushTextPrimary" Color="#1F2937" />
      <SolidColorBrush x:Key="BrushTextSecondary" Color="#6B7280" />
      <SolidColorBrush x:Key="BrushAccent" Color="#3B82F6" />
      <SolidColorBrush x:Key="BrushError" Color="#EF4444" />
      <SolidColorBrush x:Key="BrushWarning" Color="#F59E0B" />
      <SolidColorBrush x:Key="BrushSuccess" Color="#10B981" />
      <SolidColorBrush x:Key="BrushOnAccent" Color="#FFFFFF" />
  
      <!-- Новые цвета для hover и выделения -->
      <SolidColorBrush x:Key="BrushHover" Color="#F3F4F6" />
      <SolidColorBrush x:Key="BrushSelected" Color="#DBEAFE" />
      <SolidColorBrush x:Key="BrushSelectedBorder" Color="#3B82F6" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="BrushBackground" Color="#0A0A0A" />
      <SolidColorBrush x:Key="BrushSurface" Color="#121212" />
      <SolidColorBrush x:Key="BrushBorder" Color="#1F1F1F" />
      <SolidColorBrush x:Key="BrushTextPrimary" Color="#FFFFFF" />
      <SolidColorBrush x:Key="BrushTextSecondary" Color="#B0B0B0" />
      <SolidColorBrush x:Key="BrushAccent" Color="#00FF00" />
      <SolidColorBrush x:Key="BrushError" Color="#FF4444" />
      <SolidColorBrush x:Key="BrushWarning" Color="#FFA500" />
      <SolidColorBrush x:Key="BrushSuccess" Color="#00C853" />
      <SolidColorBrush x:Key="BrushOnAccent" Color="#000000" />
  
      <!-- Новые цвета для hover и выделения -->
      <SolidColorBrush x:Key="BrushHover" Color="#1F1F1F" />
      <SolidColorBrush x:Key="BrushSelected" Color="#003300" />
      <SolidColorBrush x:Key="BrushSelectedBorder" Color="#00FF00" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <x:Double x:Key="FontSizeSmall">12</x:Double>
  <x:Double x:Key="FontSizeBody">14</x:Double>
  <x:Double x:Key="FontSizeField">16</x:Double>
  <x:Double x:Key="FontSizeSubtitle">20</x:Double>
  <x:Double x:Key="FontSizeTitle">24</x:Double>
  <x:Double x:Key="FontSizeCounter">32</x:Double>

  <FontWeight x:Key="FontWeightRegular">400</FontWeight>
  <FontWeight x:Key="FontWeightAccent">600</FontWeight>

  <x:Double x:Key="SpacingXs">4</x:Double>
  <x:Double x:Key="SpacingSm">8</x:Double>
  <x:Double x:Key="SpacingMd">12</x:Double>
  <x:Double x:Key="SpacingLg">16</x:Double>
  <x:Double x:Key="SpacingXl">24</x:Double>
  <x:Double x:Key="SpacingXxl">32</x:Double>

  <CornerRadius x:Key="RadiusControl">4</CornerRadius>
  <CornerRadius x:Key="RadiusCard">8</CornerRadius>

  <Thickness x:Key="PaddingControl">16,8</Thickness>
  <Thickness x:Key="PaddingCard">16</Thickness>
  <Thickness x:Key="MarginPage">24</Thickness>

  <x:Double x:Key="MarkerSize">12</x:Double>

  <x:Double x:Key="ArchivedMarkerOpacity">0.4</x:Double>

</ResourceDictionary>
