<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TimeTracker.Presentation.ViewModels"
        xmlns:views="using:TimeTracker.Presentation.Views"
        x:Class="TimeTracker.Presentation.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{DynamicResource App.Title}"
        Icon="/Assets/app.ico"
        Width="900"
        Height="600"
        MinWidth="640"
        MinHeight="420"
        WindowStartupLocation="CenterScreen">

  <Grid Background="{DynamicResource BrushBackground}"
        RowDefinitions="Auto,*">

    <StackPanel Grid.Row="0"
                Orientation="Horizontal"
                Spacing="{DynamicResource SpacingMd}"
                HorizontalAlignment="Right"
                Margin="{DynamicResource MarginFilter}">

      <Button Content="{DynamicResource Settings.Title}"
              Command="{Binding OpenSettingsCommand}" />

      <Button Content="{DynamicResource Reports.Title}"
              Command="{Binding OpenReportsCommand}" />

    </StackPanel>

    <ContentControl Grid.Row="1" Content="{Binding Page}">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="vm:TasksViewModel">
          <views:TasksView />
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>

  </Grid>

</Window>
