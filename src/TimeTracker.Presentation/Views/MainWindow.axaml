<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TimeTracker.Presentation.ViewModels"
        xmlns:domain="using:TimeTracker.Domain"
        x:Class="TimeTracker.Presentation.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="TimeTracker"
        Width="900"
        Height="600"
        MinWidth="640"
        MinHeight="420"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="Auto,Auto,*"
        Margin="24">

    <TextBlock Grid.Row="0"
               Text="{Binding Path=Counter}"
               FontSize="72"
               FontFamily="{StaticResource ContentControlThemeFontFamily}"
               HorizontalAlignment="Center" />

    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                Spacing="12"
                Margin="0,16"
                HorizontalAlignment="Center">

      <Button Content="{Binding ToggleCaption}"
              Command="{Binding ToggleCommand}"
              Padding="24,8"
              FontSize="18" />

      <Button Content="Stop"
              Command="{Binding FinishCommand}"
              Padding="24,8"
              FontSize="18" />

    </StackPanel>

    <ListBox Grid.Row="2"
             ItemsSource="{Binding Entries}">

      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="domain:TimeEntry">

          <StackPanel Orientation="Horizontal"
                      Spacing="12">

            <TextBlock Text="{Binding StartedAt, StringFormat='{}{0:HH:mm}'}" />
            <TextBlock Text="{Binding EndedAt, StringFormat='{}{0:HH:mm}'}" />
            <TextBlock Text="{Binding Description}" />

          </StackPanel>

        </DataTemplate>
      </ListBox.ItemTemplate>

    </ListBox>

  </Grid>

</Window>
