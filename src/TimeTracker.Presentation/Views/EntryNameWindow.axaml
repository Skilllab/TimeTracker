<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TimeTracker.Presentation.ViewModels"
        x:Class="TimeTracker.Presentation.Views.EntryNameWindow"
        x:DataType="vm:EntryNameViewModel"
        Title="{Binding Title}"
        Width="420"
        Height="220"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <Grid Margin="{DynamicResource MarginPage}"
        RowDefinitions="Auto,Auto,*,Auto"
        RowSpacing="{DynamicResource SpacingLg}">

    <TextBlock Grid.Row="0"
               Classes="title"
               Text="{Binding Title}" />

    <StackPanel Grid.Row="1"
                Spacing="{DynamicResource SpacingSm}">

      <TextBlock Text="{DynamicResource Entries.Name}" />

      <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

    </StackPanel>

    <StackPanel Grid.Row="3"
                Orientation="Horizontal"
                Spacing="{DynamicResource SpacingMd}"
                HorizontalAlignment="Right">

      <Button Content="{DynamicResource Entries.Save}"
              Command="{Binding ConfirmCommand}"
              Classes="accent" />

      <Button Content="{DynamicResource Entries.Cancel}"
              Command="{Binding CancelCommand}" />

    </StackPanel>

  </Grid>

</Window>
