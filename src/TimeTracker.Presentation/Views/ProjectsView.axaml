<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TimeTracker.Presentation.ViewModels"
             xmlns:domain="using:TimeTracker.Domain"
             x:Class="TimeTracker.Presentation.Views.ProjectsView"
             x:DataType="vm:ProjectsViewModel">

  <DockPanel Margin="{DynamicResource MarginPage}"
             LastChildFill="True">

    <StackPanel DockPanel.Dock="Top"
                Spacing="{DynamicResource SpacingMd}">

      <TextBlock Classes="title"
                 Text="{DynamicResource Projects.Title}" />

      <StackPanel Orientation="Horizontal"
                  Spacing="{DynamicResource SpacingMd}">

        <Button Content="{DynamicResource Projects.Create}"
                Command="{Binding CreateCommand}"
                Classes="accent" />

        <CheckBox Content="{DynamicResource Projects.ShowArchived}"
                  IsChecked="{Binding ShowArchived}" />

      </StackPanel>

    </StackPanel>

    <ListBox Margin="{DynamicResource PaddingCard}"
             ItemsSource="{Binding Projects}">

      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="domain:Project">

          <Grid ColumnDefinitions="Auto,*,Auto">

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="{DynamicResource SpacingMd}">

              <Border Classes="marker"
                      Background="{Binding Color, Converter={StaticResource HexColorToBrush}}" />

              <TextBlock Text="{Binding Name}" />

              <TextBlock Classes="secondary"
                         Text="{DynamicResource Projects.Archived}"
                         IsVisible="{Binding IsArchived}" />

            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="{DynamicResource SpacingSm}">

              <Button Content="{DynamicResource Projects.Edit}"
                      Command="{Binding $parent[ItemsControl].((vm:ProjectsViewModel)DataContext).EditCommand}"
                      CommandParameter="{Binding}" />

              <Button Content="{DynamicResource Projects.Archive}"
                      Command="{Binding $parent[ItemsControl].((vm:ProjectsViewModel)DataContext).ArchiveCommand}"
                      CommandParameter="{Binding}"
                      IsVisible="{Binding !IsArchived}" />

              <Button Content="{DynamicResource Projects.Unarchive}"
                      Command="{Binding $parent[ItemsControl].((vm:ProjectsViewModel)DataContext).UnarchiveCommand}"
                      CommandParameter="{Binding}"
                      IsVisible="{Binding IsArchived}" />

            </StackPanel>

          </Grid>

        </DataTemplate>
      </ListBox.ItemTemplate>

    </ListBox>

  </DockPanel>

</UserControl>
