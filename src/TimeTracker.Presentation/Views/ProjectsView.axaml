<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TimeTracker.Presentation.ViewModels"
             xmlns:domain="using:TimeTracker.Domain"
             x:Class="TimeTracker.Presentation.Views.ProjectsView"
             x:DataType="vm:ProjectsViewModel">

  <DockPanel Margin="{DynamicResource MarginPage}"
             LastChildFill="True">

    <TextBlock DockPanel.Dock="Top"
               Classes="title"
               Text="{DynamicResource Projects.Title}" />

    <ListBox Margin="{DynamicResource PaddingCard}"
             ItemsSource="{Binding Projects}">

      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="domain:Project">

          <StackPanel Orientation="Horizontal"
                      Spacing="{DynamicResource SpacingMd}">

            <Border Classes="marker"
                    Background="{Binding Color, Converter={StaticResource HexColorToBrush}}" />

            <TextBlock Text="{Binding Name}" />

          </StackPanel>

        </DataTemplate>
      </ListBox.ItemTemplate>

    </ListBox>

  </DockPanel>

</UserControl>
