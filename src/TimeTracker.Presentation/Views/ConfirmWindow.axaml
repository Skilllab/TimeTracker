<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TimeTracker.Presentation.ViewModels"
        x:Class="TimeTracker.Presentation.Views.ConfirmWindow"
        x:DataType="vm:ConfirmViewModel"
        Title="{Binding Title}"
        Width="460"
        Height="240"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <Grid Margin="{DynamicResource MarginPage}"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="{DynamicResource SpacingLg}">

    <TextBlock Grid.Row="0"
               Classes="title"
               Text="{Binding Title}" />

    <TextBlock Grid.Row="1"
               TextWrapping="Wrap"
               Text="{Binding Question}" />

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                Spacing="{DynamicResource SpacingMd}"
                HorizontalAlignment="Right">

      <Button Content="{DynamicResource Tasks.ConfirmYes}"
              Command="{Binding ConfirmCommand}"
              Classes="accent" />

      <Button Content="{DynamicResource Tasks.ConfirmNo}"
              Command="{Binding CancelCommand}" />

    </StackPanel>

  </Grid>

</Window>
