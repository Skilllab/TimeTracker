<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TimeTracker.Presentation.ViewModels"
             x:Class="TimeTracker.Presentation.Views.EntriesView"
             x:DataType="vm:EntriesViewModel">

  <DockPanel Margin="{DynamicResource MarginPage}"
             LastChildFill="True">

    <TextBlock DockPanel.Dock="Top"
               Classes="title"
               Text="{DynamicResource Entries.Title}" />

    <ListBox Margin="{DynamicResource PaddingCard}"
             ItemsSource="{Binding Entries}">

      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:EntryRowViewModel">

          <Grid ColumnDefinitions="*,Auto">

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="{DynamicResource SpacingMd}">

              <TextBlock Text="{Binding Entry.StartedAt, StringFormat='{}{0:HH:mm}'}" />
              <TextBlock Classes="secondary"
                         Text="{Binding Entry.EndedAt, StringFormat='{}{0:HH:mm}'}" />
              <TextBlock Text="{Binding TaskName}" />

              <Border Classes="marker"
                      Background="{Binding ProjectColor, Converter={StaticResource HexColorToBrush}}" />

              <TextBlock Classes="secondary"
                         Text="{Binding ProjectName}" />

            </StackPanel>

            <Button Grid.Column="1"
                    Content="{DynamicResource Entries.Rename}"
                    Command="{Binding $parent[ItemsControl].((vm:EntriesViewModel)DataContext).RenameCommand}"
                    CommandParameter="{Binding}"
                    IsVisible="{Binding CanRename}" />

          </Grid>

        </DataTemplate>
      </ListBox.ItemTemplate>

    </ListBox>

  </DockPanel>

</UserControl>
