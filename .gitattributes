# Нормализация переводов строк: в репозитории всегда LF
* text=auto eol=lf

# Явные типы по расширениям
*.cs        text diff=csharp
*.csx       text diff=csharp
*.csproj    text
*.fsproj    text
*.slnx      text
*.props     text
*.targets   text
*.axaml     text
*.xaml      text
*.json      text
*.yml       text
*.yaml      text
*.md        text
*.gitignore text

# Бинарные файлы — не трогать
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.icns binary
*.dll  binary
*.exe  binary
